# Application
NODE_ENV=development
PORT=5000

# PostgreSQL Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=devtrack
DB_USER=postgres
DB_PASSWORD=replace_with_local_password

# Authentication
JWT_SECRET=replace_with_a_secure_secret_of_at_least_32_chars
JWT_EXPIRES_IN=1d
COOKIE_SECURE=false

# Frontend
CLIENT_URL=http://localhost:5173
COMPOSE_CLIENT_URL=http://localhost:8080